# Configuration de l'application BiblioTEC
# Copiez ce fichier en .env et modifiez les valeurs selon votre environnement

# ============================================================================
# Django Settings
# ============================================================================
DEBUG=True
SECRET_KEY=django-insecure-qlgkgnoi6vl_#1yq=mymy#b9f4t)ijp*2o1p8o9m*9fe5tg180
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ============================================================================
# Database Configuration (PostgreSQL)
# ============================================================================
POSTGRES_DB=bibliotec_db
POSTGRES_USER=bibliotec_user
POSTGRES_PASSWORD=changeme123
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bibliotec_user:changeme123@db:5432/bibliotec_db

# SQLite (alternative, pour développement)
# DATABASE_URL=sqlite:///data/db.sqlite3

# ============================================================================
# Email Configuration
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password

# ============================================================================
# Application Settings
# ============================================================================
LANGUAGE_CODE=fr-fr
TIME_ZONE=Africa/Dakar
USE_I18N=True
USE_TZ=True

# ============================================================================
# Media and Static Files
# ============================================================================
MEDIA_URL=/media/
STATIC_URL=/static/
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles

# ============================================================================
# Security Settings (production)
# ============================================================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ============================================================================
# CORS Settings
# ============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# Gunicorn Settings
# ============================================================================
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# ============================================================================
# Superuser par défaut
# ============================================================================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@uadb.edu.sn
DJANGO_SUPERUSER_PASSWORD=admin123

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO
